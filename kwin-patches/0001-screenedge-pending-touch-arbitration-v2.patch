+void ScreenEdgesTest::testJitterRejectionAndFlickCommitment()
+{
+    // Verifies:
+    // 1. Movement within touch slop (<= 5px) is kept Pending.
+    // 2. High velocity without minimum directional travel (< 10px) is rejected.
+    // 3. Flick (travel >= 10px, velocity >= 0.48 px/ms) commits to GestureOwned.
+    // 4. Release before activation distance (< 44px) cancels gesture without triggering action.
+    // 5. Slow inward swipe with displacement >= 16px commits even at low velocity.
+    // 6. Release after activation distance (>= 44px) triggers the action.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    // Case A: Jitter and flick test
+    quint32 timestamp = 800;
+    Test::touchDown(12, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Jitter: move 2px inward at t+5ms (inward = 2 <= 5px slop)
+    timestamp += 5;
+    Test::touchMotion(12, QPointF(4, 51), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Fast twitch: move to 8px inward at t+6ms (1ms delta, 4px travel -> 4 px/ms, but total inward 6px < 10px)
+    timestamp += 1;
+    Test::touchMotion(12, QPointF(8, 51), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Genuine flick: move to 15px inward at t+20ms (dt = 20ms, inward = 13px >= 10px, velocity = 13/20 = 0.65 px/ms >= 0.48)
+    timestamp += 14;
+    Test::touchMotion(12, QPointF(15, 51), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+
+    // Release before 44px: inward is 13px < 44px
+    timestamp += 5;
+    Test::touchUp(12, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QTest::qWait(20);
+    QCOMPARE(actionSpy.count(), 0); // Action not triggered!
+
+    // Case B: Slow inward commitment and full activation test
+    timestamp += 100;
+    Test::touchDown(13, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Slow inward movement: move to 19px inward over 60ms (velocity = 17/60 = 0.28 px/ms < 0.48 px/ms)
+    // But displacement = 17px >= 16px (commitment distance)
+    timestamp += 60;
+    Test::touchMotion(13, QPointF(19, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+
+    // Drag further past 44px activation threshold: inward = 48px >= 44px
+    timestamp += 20;
+    Test::touchMotion(13, QPointF(50, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+
+    // Release past activation threshold
+    timestamp += 5;
+    Test::touchUp(13, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QVERIFY(actionSpy.wait());
+    QCOMPARE(actionSpy.count(), 1); // Action triggered!
+
+    s->unreserveTouch(ElectricLeft, &action);
+}
+
+void ScreenEdgesTest::testTargetInvalidationFailClosed()
+{
+    // Verifies that if a target window is minimized or closed while a touch is pending,
+    // the recognizer drops all buffered events fail-closed rather than dispatching them.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    s->reserveTouch(ElectricLeft, &action);
+
+    std::unique_ptr<KWayland::Client::Surface> surface = Test::createSurface();
+    QVERIFY(surface);
+    std::unique_ptr<Test::XdgToplevel> shellSurface = Test::createXdgToplevelSurface(surface.get());
+    QVERIFY(shellSurface);
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(200, 200), Qt::blue);
+    QVERIFY(window);
+    window->move(QPoint(0, 0));
+    QCOMPARE(workspace()->activeWindow(), window);
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downCount++;
+            return false;
+        }
+        int downCount = 0;
+    };
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    // Touch down on window in edge zone (pos = (2, 50))
+    quint32 timestamp = 900;
+    Test::touchDown(14, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(filter.downCount, 0);
+
+    // Invalidate target window by minimizing it
+    window->setMinimized(true);
+    QCOMPARE(window->isMinimized(), true);
+
+    // Lift touch: pending queue replay checks validateTarget(), fails closed, drops queue.
+    timestamp += 10;
+    Test::touchUp(14, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QCOMPARE(filter.downCount, 0); // No events dispatched to invalidated target!
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
