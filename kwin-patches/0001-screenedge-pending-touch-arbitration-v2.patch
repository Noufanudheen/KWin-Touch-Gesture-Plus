+    bool hasPendingFrame = false;
+    for (const auto &event : m_pendingQueue) {
+        switch (event.type) {
+        case PendingEventType::Down: {
+            if (m_replayTouchDown) {
+                TouchDownEvent ev{
+                    .id = static_cast<qint32>(event.id),
+                    .pos = event.pos,
+                    .time = event.time,
+                };
+                m_replayTouchDown(ev);
+                hasPendingFrame = true;
+            }
+            break;
+        }
+        case PendingEventType::Motion: {
+            if (m_replayTouchMotion) {
+                TouchMotionEvent ev{
+                    .id = static_cast<qint32>(event.id),
+                    .pos = event.pos,
+                    .time = event.time,
+                };
+                m_replayTouchMotion(ev);
+                hasPendingFrame = true;
+            }
+            break;
+        }
+        case PendingEventType::Up: {
+            if (hasPendingFrame && m_replayTouchFrame) {
+                m_replayTouchFrame();
+                hasPendingFrame = false;
+            }
+            if (m_replayTouchUp) {
+                TouchUpEvent ev{
+                    .id = static_cast<qint32>(event.id),
+                    .time = event.time,
+                };
+                m_replayTouchUp(ev);
+                hasPendingFrame = true;
+            }
+            break;
+        }
+        case PendingEventType::Frame: {
+            if (m_replayTouchFrame && hasPendingFrame) {
+                m_replayTouchFrame();
+                hasPendingFrame = false;
+            }
+            break;
+        }
+        }
+    }
+
+    if (hasPendingFrame && m_replayTouchFrame) {
+        m_replayTouchFrame();
+    }
+
+    m_pendingQueue.clear();
+}
