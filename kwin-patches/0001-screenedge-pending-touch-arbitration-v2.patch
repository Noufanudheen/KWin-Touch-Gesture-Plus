+void ScreenEdgesTest::testUpstreamFilterSingleInvocation()
+{
+    // Verifies that when ScreenEdgeInputFilter replays buffered events to downstream filters,
+    // upstream filters (such as LockScreen, order < ScreenEdge) are NEVER called again.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    s->reserveTouch(ElectricLeft, &action);
+
+    struct UpstreamFilter : public InputEventFilter
+    {
+        UpstreamFilter()
+            : InputEventFilter(InputFilterOrder::LockScreen)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downCount++;
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionCount++;
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upCount++;
+            return false;
+        }
+        int downCount = 0;
+        int motionCount = 0;
+        int upCount = 0;
+    };
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downCount++;
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionCount++;
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upCount++;
+            return false;
+        }
+        int downCount = 0;
+        int motionCount = 0;
+        int upCount = 0;
+    };
+
+    UpstreamFilter upstream;
+    DownstreamFilter downstream;
+    input()->installInputEventFilter(&upstream);
+    input()->installInputEventFilter(&downstream);
+
+    quint32 timestamp = 700;
+    // Initial touchDown arrives: upstream observes it once, ScreenEdge intercepts it as Pending.
+    Test::touchDown(10, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(upstream.downCount, 1);
+    QCOMPARE(downstream.downCount, 0);
+
+    // Motion within slop (<= 5px): upstream observes it once, ScreenEdge buffers it.
+    timestamp += 5;
+    Test::touchMotion(10, QPointF(3, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(upstream.motionCount, 1);
+    QCOMPARE(downstream.motionCount, 0);
+
+    // Touch up arrives: pending tap is resolved and flushed to downstream filters.
+    timestamp += 10;
+    Test::touchUp(10, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+
+    // Downstream filter received all replayed events:
+    QCOMPARE(downstream.downCount, 1);
+    QCOMPARE(downstream.motionCount, 1);
+    QCOMPARE(downstream.upCount, 1);
+
+    // Upstream filter was NOT re-entered during replay:
+    QCOMPARE(upstream.downCount, 1);
+    QCOMPARE(upstream.motionCount, 1);
+    QCOMPARE(upstream.upCount, 1);
+
+    input()->uninstallInputEventFilter(&upstream);
+    input()->uninstallInputEventFilter(&downstream);
+    s->unreserveTouch(ElectricLeft, &action);
+}
