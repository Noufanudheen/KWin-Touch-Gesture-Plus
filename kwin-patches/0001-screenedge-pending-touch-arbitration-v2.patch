+void ScreenEdgesTest::testTapForwarding()
+{
+    // Verifies that a quick tap in an edge gesture zone does NOT trigger the gesture,
+    // and instead replays down and up events downstream.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+    QVERIFY(recognizer);
+
+    QAction action;
+    QSignalSpy actionTriggeredSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    struct TestFilter : public InputEventFilter {
+        TestFilter() : InputEventFilter(InputFilterOrder::Forward) {}
+        bool touchDown(TouchDownEvent *event) override {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override {
+            upEvents.append(*event);
+            return false;
+        }
+        bool touchFrame() override {
+            frameCount++;
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchUpEvent> upEvents;
+        int frameCount = 0;
+    };
+
+    TestFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 100;
+    Test::touchDown(1, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    timestamp += 15;
+    Test::touchUp(1, timestamp);
+
+    QCOMPARE(actionTriggeredSpy.count(), 0);
+    QCOMPARE(filter.downEvents.count(), 1);
+    QCOMPARE(filter.downEvents.first().pos, QPointF(2, 50));
+    QCOMPARE(filter.upEvents.count(), 1);
+    QCOMPARE(filter.upEvents.first().id, 1);
+    QVERIFY(filter.frameCount >= 2);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
+
+void ScreenEdgesTest::testHoldToScroll()
+{
+    // Verifies that movement parallel to the edge (> 10px parallel, <= 3px inward)
+    // transitions from Pending to ApplicationOwned without triggering the gesture.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionTriggeredSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    struct TestFilter : public InputEventFilter {
+        TestFilter() : InputEventFilter(InputFilterOrder::Forward) {}
+        bool touchDown(TouchDownEvent *event) override {
+            downCount++;
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override {
+            motionPoints.append(event->pos);
+            return false;
+        }
+        int downCount = 0;
+        QList<QPointF> motionPoints;
+    };
+
+    TestFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 200;
+    Test::touchDown(2, QPointF(2, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Move parallel: delta Y = 20px, delta X = 1px (inward 1px <= 3px)
+    timestamp += 10;
+    Test::touchMotion(2, QPointF(3, 120), timestamp);
+
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::ApplicationOwned);
+    QCOMPARE(filter.downCount, 1);
+    QCOMPARE(filter.motionPoints.count(), 1);
+    QCOMPARE(filter.motionPoints.first(), QPointF(3, 120));
+    QCOMPARE(actionTriggeredSpy.count(), 0);
+
+    timestamp += 10;
+    Test::touchUp(2, timestamp);
+    QCOMPARE(actionTriggeredSpy.count(), 0);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
