+void ScreenEdgesTest::testCandidateTimeoutHandoff()
+{
+    // Verifies Requirement 4:
+    // Candidate timeout (200ms) prevents recognizer from holding normal input indefinitely.
+    // If inward travel reaches gesture candidate state but stalls, it transitions
+    // to ApplicationOwned and flushes buffered events to the application.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    s->reserveTouch(ElectricLeft, &action);
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upEvents.append(*event);
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchMotionEvent> motionEvents;
+        QList<TouchUpEvent> upEvents;
+    };
+
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 1200;
+    Test::touchDown(21, QPointF(2, 150), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Move to 20px inward (enters GestureCandidate)
+    timestamp += 10;
+    Test::touchMotion(21, QPointF(20, 150), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureCandidate);
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // Wait 220ms for candidate timeout (200ms)
+    QTest::qWait(220);
+
+    // Recognizer must have timed out and handed off to ApplicationOwned!
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::ApplicationOwned);
+    QCOMPARE(filter.downEvents.count(), 1);
+    QCOMPARE(filter.downEvents.first().pos, QPointF(2, 150));
+    QCOMPARE(filter.motionEvents.count(), 1);
+    QCOMPARE(filter.motionEvents.first().pos, QPointF(20, 150));
+
+    // Subsequent motions pass directly to application
+    timestamp += 20;
+    Test::touchMotion(21, QPointF(25, 150), timestamp);
+    QCOMPARE(filter.motionEvents.count(), 2);
+    QCOMPARE(filter.motionEvents.at(1).pos, QPointF(25, 150));
+
+    // Release
+    timestamp += 10;
+    Test::touchUp(21, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QCOMPARE(filter.upEvents.count(), 1);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
