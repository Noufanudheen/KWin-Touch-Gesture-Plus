+void ScreenEdgesTest::testIncompleteGesturePreservesTouches()
+{
+    // Verifies Requirement 7 & 8:
+    // A gesture candidate moves inward beyond the early commitment threshold (16px),
+    // releases before 44px activation distance, and verifies BOTH:
+    // 1. No system gesture action fires.
+    // 2. The downstream recipient receives the full, ordered touch sequence.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    // Create a real Wayland client window covering the touch region (0, 0, 300, 300)
+    std::unique_ptr<KWayland::Client::Surface> surface = Test::createSurface();
+    QVERIFY(surface);
+    std::unique_ptr<Test::XdgToplevel> shellSurface = Test::createXdgToplevelSurface(surface.get());
+    QVERIFY(shellSurface);
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(300, 300), Qt::blue);
+    QVERIFY(window);
+    window->move(QPoint(0, 0));
+    QCOMPARE(workspace()->activeWindow(), window);
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upEvents.append(*event);
+            return false;
+        }
+        bool touchFrame() override
+        {
+            frameCount++;
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchMotionEvent> motionEvents;
+        QList<TouchUpEvent> upEvents;
+        int frameCount = 0;
+    };
+
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 1000;
+    // Touch down near left edge on the client window
+    Test::touchDown(20, QPointF(2, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // Move inward to 20px (inward 18px > 16px early commitment threshold)
+    timestamp += 10;
+    Test::touchMotion(20, QPointF(20, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureCandidate);
+    QCOMPARE(filter.motionEvents.count(), 0); // Still held in recognizer candidate buffer
+
+    // Move further inward to 30px (inward 28px, still < 44px activation threshold)
+    timestamp += 10;
+    Test::touchMotion(20, QPointF(30, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureCandidate);
+    QCOMPARE(filter.motionEvents.count(), 0);
+
+    // Release before 44px activation threshold
+    timestamp += 10;
+    Test::touchUp(20, timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+
+    // Wait and verify NO system gesture action fired
+    QTest::qWait(20);
+    QCOMPARE(actionSpy.count(), 0);
+
+    // Verify downstream recipient received the complete, ordered touch sequence
+    QCOMPARE(filter.downEvents.count(), 1);
+    QCOMPARE(filter.downEvents.first().pos, QPointF(2, 100));
+    QCOMPARE(filter.downEvents.first().id, 20);
+
+    QCOMPARE(filter.motionEvents.count(), 2);
+    QCOMPARE(filter.motionEvents.at(0).pos, QPointF(20, 100));
+    QCOMPARE(filter.motionEvents.at(0).id, 20);
+    QCOMPARE(filter.motionEvents.at(1).pos, QPointF(30, 100));
+    QCOMPARE(filter.motionEvents.at(1).id, 20);
+
+    QCOMPARE(filter.upEvents.count(), 1);
+    QCOMPARE(filter.upEvents.first().id, 20);
+    QVERIFY(filter.frameCount >= 2);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
