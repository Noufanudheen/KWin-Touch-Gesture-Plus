+void ScreenEdgesTest::testTargetDestructionDuringPendingTimeout()
+{
+    // Fix 2: Quarantine dropped contacts after target invalidation during Pending timeout.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    s->reserveTouch(ElectricLeft, &action);
+
+    std::unique_ptr<KWayland::Client::Surface> surface = Test::createSurface();
+    QVERIFY(surface);
+    std::unique_ptr<Test::XdgToplevel> shellSurface = Test::createXdgToplevelSurface(surface.get());
+    QVERIFY(shellSurface);
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(300, 300), Qt::blue);
+    QVERIFY(window);
+    window->move(QPoint(0, 0));
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upEvents.append(*event);
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchMotionEvent> motionEvents;
+        QList<TouchUpEvent> upEvents;
+    };
+
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 3000;
+    Test::touchDown(40, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // Destroy target window while contact is pending
+    shellSurface.reset();
+    surface.reset();
+    Test::flushWaylandConnection();
+
+    // Wait for pending timeout (50ms)
+    QTest::qWait(70);
+
+    // Target validation failed; queue dropped; contact 40 quarantined
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Quarantined);
+    QVERIFY(std::ranges::find(recognizer->quarantinedTouchIds(), 40) != recognizer->quarantinedTouchIds().end());
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // Send subsequent motion for quarantined contact: must be consumed and NOT leaked downstream
+    timestamp += 20;
+    Test::touchMotion(40, QPointF(5, 50), timestamp);
+    QCOMPARE(filter.motionEvents.count(), 0);
+
+    // Send release for quarantined contact: must be consumed and NOT leaked downstream
+    timestamp += 20;
+    Test::touchUp(40, timestamp);
+    QCOMPARE(filter.upEvents.count(), 0);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QVERIFY(recognizer->quarantinedTouchIds().empty());
+
+    // Verify recognizer recovers for a subsequent fresh touch on a new target
+    std::unique_ptr<KWayland::Client::Surface> surface2 = Test::createSurface();
+    QVERIFY(surface2);
+    std::unique_ptr<Test::XdgToplevel> shellSurface2 = Test::createXdgToplevelSurface(surface2.get());
+    QVERIFY(shellSurface2);
+    auto window2 = Test::renderAndWaitForShown(surface2.get(), QSize(300, 300), Qt::green);
+    QVERIFY(window2);
+    window2->move(QPoint(0, 0));
+
+    timestamp += 50;
+    Test::touchDown(41, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // Wait for timeout handoff to application
+    QTest::qWait(70);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::ApplicationOwned);
+    QCOMPARE(filter.downEvents.count(), 1);
+    QCOMPARE(filter.downEvents.first().id, 41);
+
+    timestamp += 20;
+    Test::touchUp(41, timestamp);
+    QCOMPARE(filter.upEvents.count(), 1);
+    QCOMPARE(filter.upEvents.first().id, 41);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
