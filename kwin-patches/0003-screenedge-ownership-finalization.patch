+void ScreenEdgesTest::testMultiTouchDuringCommittedGesture()
+{
+    // Fix 3: Keep ownership consistent after multitouch during a committed gesture.
+    // 1. Begin an edge touch.
+    // 2. Commit the gesture at or beyond 44 px.
+    // 3. Add a second contact.
+    // 4. Release the primary contact.
+    // 5. Move and release the secondary contact.
+    // 6. Assert that the action fires at most once, no orphaned events reach the application,
+    //    all IDs are cleaned up, and a later independent edge swipe works.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    std::unique_ptr<KWayland::Client::Surface> surface = Test::createSurface();
+    QVERIFY(surface);
+    std::unique_ptr<Test::XdgToplevel> shellSurface = Test::createXdgToplevelSurface(surface.get());
+    QVERIFY(shellSurface);
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(300, 300), Qt::blue);
+    QVERIFY(window);
+    window->move(QPoint(0, 0));
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upEvents.append(*event);
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchMotionEvent> motionEvents;
+        QList<TouchUpEvent> upEvents;
+    };
+
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 5000;
+    // 1. Begin an edge touch
+    Test::touchDown(50, QPointF(2, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    // 2. Commit gesture at or beyond 44px
+    timestamp += 20;
+    Test::touchMotion(50, QPointF(50, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QCOMPARE(recognizer->isGestureCommitted(), true);
+
+    // 3. Add a second contact
+    timestamp += 10;
+    Test::touchDown(51, QPointF(200, 200), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QVERIFY(std::ranges::find(recognizer->consumedTouchIds(), 51) != recognizer->consumedTouchIds().end());
+
+    // 4. Release the primary contact
+    timestamp += 20;
+    Test::touchUp(50, timestamp);
+    QTest::qWait(20);
+    // Primary contact release triggers the committed action!
+    QCOMPARE(actionSpy.count(), 1);
+    // Recognizer must NOT reset to Idle because contact 51 remains consumed!
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QVERIFY(std::ranges::find(recognizer->consumedTouchIds(), 51) != recognizer->consumedTouchIds().end());
+
+    // 5. Move and release the secondary contact
+    timestamp += 20;
+    Test::touchMotion(51, QPointF(210, 210), timestamp);
+    QCOMPARE(filter.motionEvents.count(), 0); // Consumed, not leaked to application!
+
+    timestamp += 20;
+    Test::touchUp(51, timestamp);
+    QCOMPARE(filter.upEvents.count(), 0); // Consumed, not leaked to application!
+
+    // Action must fire at most once (count remains 1)
+    QCOMPARE(actionSpy.count(), 1);
+
+    // All IDs cleaned up and recognizer returned to Idle
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QVERIFY(recognizer->consumedTouchIds().empty());
+
+    // 6. Assert later independent edge swipe works cleanly
+    timestamp += 50;
+    Test::touchDown(52, QPointF(2, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    timestamp += 20;
+    Test::touchMotion(52, QPointF(55, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QCOMPARE(recognizer->isGestureCommitted(), true);
+
+    timestamp += 20;
+    Test::touchUp(52, timestamp);
+    QTest::qWait(20);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QCOMPARE(actionSpy.count(), 2);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
