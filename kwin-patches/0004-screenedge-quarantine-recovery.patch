+void ScreenEdgesTest::testDirectGestureCommitmentEmitsStartedBeforeProgress()
+{
+    // Fix B: Emit gesture start for direct commitment.
+    // When a gesture crosses 44px on its first qualifying movement directly from Pending,
+    // verify start, progress, and action signals occur in the correct order,
+    // and the action fires exactly once.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    // Find the gesture for the reserved edge
+    QVERIFY(!recognizer->gestures().empty());
+    ScreenEdgeGesture *gesture = recognizer->gestures().front();
+    QVERIFY(gesture);
+
+    QStringList signalOrder;
+    connect(gesture, &ScreenEdgeGesture::started, this, [&signalOrder]() {
+        signalOrder.append(QStringLiteral("started"));
+    });
+    connect(gesture, &ScreenEdgeGesture::progress, this, [&signalOrder](const QPointF &, qreal) {
+        signalOrder.append(QStringLiteral("progress"));
+    });
+    connect(&action, &QAction::triggered, this, [&signalOrder]() {
+        signalOrder.append(QStringLiteral("triggered"));
+    });
+
+    QSignalSpy startedSpy(gesture, &ScreenEdgeGesture::started);
+    QSignalSpy progressSpy(gesture, &ScreenEdgeGesture::progress);
+
+    quint32 timestamp = 8000;
+    // 1. Touch down in edge zone
+    Test::touchDown(70, QPointF(2, 100), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(startedSpy.count(), 0);
+    QCOMPARE(progressSpy.count(), 0);
+
+    // 2. First motion directly crosses activation distance (inward = 48px >= 44px)
+    timestamp += 20;
+    Test::touchMotion(70, QPointF(50, 100), timestamp);
+
+    // Recognizer committed directly to GestureOwned
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QCOMPARE(recognizer->isGestureCommitted(), true);
+
+    // Verify started and progress signals fired
+    QCOMPARE(startedSpy.count(), 1);
+    QVERIFY(progressSpy.count() >= 1);
+
+    // Verify signal order: started MUST precede progress!
+    QVERIFY(signalOrder.count() >= 2);
+    QCOMPARE(signalOrder.at(0), QStringLiteral("started"));
+    QCOMPARE(signalOrder.at(1), QStringLiteral("progress"));
+
+    // 3. Subsequent retreat motion back toward edge
+    timestamp += 20;
+    Test::touchMotion(70, QPointF(20, 100), timestamp);
+    // Recognizer remains GestureOwned; does NOT emit started again!
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QCOMPARE(recognizer->isGestureCommitted(), true);
+    QCOMPARE(startedSpy.count(), 1);
+
+    // 4. Release contact
+    timestamp += 20;
+    Test::touchUp(70, timestamp);
+    QTest::qWait(20);
+
+    // Action fired exactly once
+    QCOMPARE(actionSpy.count(), 1);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QCOMPARE(recognizer->isGestureCommitted(), false);
+
+    // Verify final signal order ends with triggered
+    QCOMPARE(signalOrder.last(), QStringLiteral("triggered"));
+
+    s->unreserveTouch(ElectricLeft, &action);
+}
