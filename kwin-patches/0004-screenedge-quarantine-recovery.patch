+void ScreenEdgesTest::testQuarantineMixedContactRecovery()
+{
+    // Fix A: Quarantined state recovery with mixed independent contacts.
+    // 1. Edge contact (60) enters Pending.
+    // 2. Target window destroyed -> contact 60 dropped fail-closed and quarantined.
+    // 3. Independent contact (61) touches down on a second window and is passed through.
+    // 4. Contact 60 lifts FIRST -> quarantined contact consumed.
+    // 5. Contact 61 lifts SECOND -> independent contact forwarded to application.
+    // 6. Assert recognizer returns to Idle, no touch event orphaned, and subsequent edge swipe works.
+    auto s = workspace()->screenEdges();
+    auto recognizer = s->gestureRecognizer();
+
+    QAction action;
+    QSignalSpy actionSpy(&action, &QAction::triggered);
+    s->reserveTouch(ElectricLeft, &action);
+
+    std::unique_ptr<KWayland::Client::Surface> surface1 = Test::createSurface();
+    QVERIFY(surface1);
+    std::unique_ptr<Test::XdgToplevel> shellSurface1 = Test::createXdgToplevelSurface(surface1.get());
+    QVERIFY(shellSurface1);
+    auto window1 = Test::renderAndWaitForShown(surface1.get(), QSize(300, 300), Qt::blue);
+    QVERIFY(window1);
+    window1->move(QPoint(0, 0));
+
+    std::unique_ptr<KWayland::Client::Surface> surface2 = Test::createSurface();
+    QVERIFY(surface2);
+    std::unique_ptr<Test::XdgToplevel> shellSurface2 = Test::createXdgToplevelSurface(surface2.get());
+    QVERIFY(shellSurface2);
+    auto window2 = Test::renderAndWaitForShown(surface2.get(), QSize(300, 300), Qt::red);
+    QVERIFY(window2);
+    window2->move(QPoint(400, 400));
+
+    struct DownstreamFilter : public InputEventFilter
+    {
+        DownstreamFilter()
+            : InputEventFilter(InputFilterOrder::Forward)
+        {
+        }
+        bool touchDown(TouchDownEvent *event) override
+        {
+            downEvents.append(*event);
+            return false;
+        }
+        bool touchMotion(TouchMotionEvent *event) override
+        {
+            motionEvents.append(*event);
+            return false;
+        }
+        bool touchUp(TouchUpEvent *event) override
+        {
+            upEvents.append(*event);
+            return false;
+        }
+        QList<TouchDownEvent> downEvents;
+        QList<TouchMotionEvent> motionEvents;
+        QList<TouchUpEvent> upEvents;
+    };
+
+    DownstreamFilter filter;
+    input()->installInputEventFilter(&filter);
+
+    quint32 timestamp = 7000;
+    // 1. Touch down near left edge on window1
+    Test::touchDown(60, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // 2. Destroy window1 while contact 60 is pending
+    shellSurface1.reset();
+    surface1.reset();
+    Test::flushWaylandConnection();
+
+    // Pending timeout expires (50ms)
+    QTest::qWait(70);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Quarantined);
+    QVERIFY(std::ranges::find(recognizer->quarantinedTouchIds(), 60) != recognizer->quarantinedTouchIds().end());
+    QCOMPARE(filter.downEvents.count(), 0);
+
+    // 3. Independent contact arrives on window2 while 60 is quarantined
+    timestamp += 20;
+    Test::touchDown(61, QPointF(450, 450), timestamp);
+    // Contact 61 is passed through to the application
+    QCOMPARE(filter.downEvents.count(), 1);
+    QCOMPARE(filter.downEvents.first().id, 61);
+
+    // Move contact 61
+    timestamp += 20;
+    Test::touchMotion(61, QPointF(460, 460), timestamp);
+    QCOMPARE(filter.motionEvents.count(), 1);
+    QCOMPARE(filter.motionEvents.first().id, 61);
+
+    // 4. Quarantined contact 60 lifts FIRST
+    timestamp += 20;
+    Test::touchUp(60, timestamp);
+    // Quarantined contact 60 release is consumed
+    QCOMPARE(filter.upEvents.count(), 0);
+    // All quarantined contacts have ended; recognizer resets state out of Quarantined
+    QVERIFY(recognizer->quarantinedTouchIds().empty());
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+
+    // 5. Independent application contact 61 lifts SECOND
+    timestamp += 20;
+    Test::touchUp(61, timestamp);
+    // Forwarded to application
+    QCOMPARE(filter.upEvents.count(), 1);
+    QCOMPARE(filter.upEvents.first().id, 61);
+
+    // Final state is Idle and clean
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+    QVERIFY(recognizer->quarantinedTouchIds().empty());
+    QCOMPARE(actionSpy.count(), 0);
+
+    // 6. Assert subsequent fresh edge swipe works cleanly
+    timestamp += 50;
+    Test::touchDown(62, QPointF(2, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Pending);
+
+    timestamp += 20;
+    Test::touchMotion(62, QPointF(55, 50), timestamp);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::GestureOwned);
+    QCOMPARE(recognizer->isGestureCommitted(), true);
+
+    timestamp += 20;
+    Test::touchUp(62, timestamp);
+    QTest::qWait(20);
+    QCOMPARE(actionSpy.count(), 1);
+    QCOMPARE(recognizer->touchState(), EdgeTouchState::Idle);
+
+    input()->uninstallInputEventFilter(&filter);
+    s->unreserveTouch(ElectricLeft, &action);
+}
