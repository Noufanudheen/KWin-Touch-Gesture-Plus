     <widget class="QWidget" name="tabCustomCommands">
      <attribute name="title">
       <string>Custom Command</string>
      </attribute>
      <layout class="QVBoxLayout" name="layoutTabCustom">
       <item>
        <widget class="QGroupBox" name="groupCustomCommands">
         <property name="title">
          <string>Custom Commands Manager</string>
         </property>
         <layout class="QVBoxLayout" name="layoutGroupCustom">
          <item>
           <widget class="QLabel" name="label_ListHeading">
            <property name="text">
             <string>Configured Custom Commands:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QListWidget" name="listCustomCommands">
            <property name="toolTip">
             <string>Select a command to edit, or click New Command to create a new one</string>
            </property>
            <property name="selectionMode">
             <enum>QAbstractItemView::SingleSelection</enum>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="labelCommandStatus">
            <property name="text">
             <string>Select a command above or click New Command</string>
            </property>
            <property name="font">
             <font>
              <bold>true</bold>
             </font>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QFormLayout" name="formCustomEditor">
            <item row="0" column="0">
             <widget class="QLabel" name="label_CustomTitle">
              <property name="text">
               <string>Title (optional):</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLineEdit" name="editCommandTitle">
              <property name="placeholderText">
               <string>e.g. Web Browser (leave blank to use Command)</string>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="label_Custom1">
              <property name="text">
               <string>Command:</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QLineEdit" name="editCommandLine">
              <property name="placeholderText">
               <string>e.g. /usr/bin/firefox, konsole, or /path/to/script.sh</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="layoutCustomButtons">
            <item>
             <widget class="QPushButton" name="btnNewCommand">
              <property name="text">
               <string>➕ New Command</string>
              </property>
              <property name="toolTip">
               <string>Start creating a new custom command</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnAddCommand">
              <property name="text">
               <string>✔ Add Command</string>
              </property>
              <property name="toolTip">
               <string>Add this command to the pack</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnSaveChanges">
              <property name="text">
               <string>💾 Save Changes</string>
              </property>
              <property name="toolTip">
               <string>Save changes to this command</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnDeleteCommand">
              <property name="text">
               <string>🗑 Delete Command</string>
              </property>
              <property name="toolTip">
               <string>Delete this command and reset any gestures using it</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnDiscardCommand">
              <property name="text">
               <string>↺ Discard</string>
              </property>
              <property name="toolTip">
               <string>Discard unsaved changes to this command</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="spacerCustomButtons">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupSyntaxHelp">
         <property name="title">
          <string>Command Syntax &amp; Usage Guide</string>
         </property>
         <layout class="QVBoxLayout" name="layoutSyntaxHelp">
          <item>
           <widget class="QLabel" name="label_SyntaxExplanation">
            <property name="text">
             <string>&lt;html&gt;&lt;body&gt;
&lt;p&gt;&lt;b&gt;How to use custom commands in gestures:&lt;/b&gt;&lt;/p&gt;
&lt;ul&gt;
  &lt;li&gt;&lt;b&gt;Title Option:&lt;/b&gt; Friendly name for display. If left blank, it automatically defaults to the Command itself.&lt;/li&gt;
  &lt;li&gt;&lt;b&gt;Activation:&lt;/b&gt; Select &lt;b&gt;Custom Command&lt;/b&gt; in any gesture dropdown in the &lt;i&gt;Touch Gestures&lt;/i&gt; tab.&lt;/li&gt;
  &lt;li&gt;&lt;b&gt;External Programs:&lt;/b&gt; &lt;code&gt;exec:/usr/bin/konsole&lt;/code&gt; or &lt;code&gt;exec:flatpak run org.mozilla.firefox&lt;/code&gt;&lt;/li&gt;
  &lt;li&gt;&lt;b&gt;Direct Commands:&lt;/b&gt; Any shell path or executable such as &lt;code&gt;/home/user/myscript.sh&lt;/code&gt; or &lt;code&gt;konsole&lt;/code&gt;&lt;/li&gt;
  &lt;li&gt;&lt;b&gt;Global KDE Shortcuts:&lt;/b&gt; &lt;code&gt;shortcut:&amp;lt;component&amp;gt;:&amp;lt;action&amp;gt;&lt;/code&gt; (e.g. &lt;code&gt;shortcut:kwin:Overview&lt;/code&gt;)&lt;/li&gt;
  &lt;li&gt;&lt;b&gt;D-Bus Calls:&lt;/b&gt; &lt;code&gt;dbus:&amp;lt;service&amp;gt;:&amp;lt;path&amp;gt;:&amp;lt;interface&amp;gt;:&amp;lt;method&amp;gt;&lt;/code&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;i&gt;Note: All action dropdowns in the Touch Gestures tab are also directly editable. You can type or paste any command directly into the gesture selector.&lt;/i&gt;&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Diagnostics &amp;amp; Storage:&lt;/b&gt; Custom commands are stored in &lt;code&gt;~/.config/kwin-touch-gesture-plus/commands/&lt;/code&gt;. Diagnostic activity is logged to &lt;code&gt;~/.local/state/kwin-touch-gesture-plus/diagnostics.log&lt;/code&gt; (inspect with &lt;code&gt;tail -F ~/.local/state/kwin-touch-gesture-plus/diagnostics.log&lt;/code&gt;). Sensitive command payloads are redacted for privacy.&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="spacerCustom">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabTabletMode">
      <attribute name="title">
       <string>Tablet Mode &amp; Sizing</string>
      </attribute>
      <layout class="QVBoxLayout" name="layoutTabTablet">
       <item>
        <widget class="QGroupBox" name="groupHinge">
         <property name="title">
          <string>Hinge Sensor Sensitivity</string>
