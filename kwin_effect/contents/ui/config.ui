         <layout class="QFormLayout" name="formHinge">
          <item row="0" column="0">
           <widget class="QLabel" name="label_HingeAngle">
            <property name="text">
             <string>Hinge Trigger Angle:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout" name="layoutHingeAngle">
            <item>
             <widget class="QSlider" name="kcfg_HingeAngleThreshold">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
              <property name="minimum">
               <number>170</number>
              </property>
              <property name="maximum">
               <number>240</number>
              </property>
              <property name="value">
               <number>185</number>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="spin_HingeAngleThreshold">
              <property name="minimum">
               <number>170</number>
              </property>
              <property name="maximum">
