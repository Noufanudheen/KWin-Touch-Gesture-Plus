{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "KWin Touch Gesture Plus Default Edge Zones Configuration",
  "zones": [
    {
      "id": "top_fullscreen_expose",
      "name": "Top Edge: Fullscreen Toggle / Expose",
      "edge": "top",
      "startFraction": 0.0,
      "endFraction": 1.0,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "fullscreen_or_expose",
      "oskPolicy": "Always",
      "safeMarginStart": 100,
      "safeMarginEnd": 150,
      "priority": 0
    },
    {
      "id": "left_activities",
      "name": "Left Edge: Activities / Task Switcher",
      "edge": "left",
      "startFraction": 0.0,
      "endFraction": 1.0,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "shortcut:plasmashell:manage activities",
      "oskPolicy": "Always",
      "safeMarginStart": 0,
      "safeMarginEnd": 0,
      "priority": 0
    },
    {
      "id": "right_notifications",
      "name": "Right Edge: System Tray / Notifications",
      "edge": "right",
      "startFraction": 0.0,
      "endFraction": 1.0,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "shortcut:plasmashell:activate widget 157",
      "oskPolicy": "Always",
      "safeMarginStart": 0,
      "safeMarginEnd": 0,
      "priority": 0
    },
    {
      "id": "bottom_launcher",
      "name": "Bottom Left: Application Launcher",
      "edge": "bottom",
      "startFraction": 0.0,
      "endFraction": 0.333,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "launcher",
      "oskPolicy": "Disabled",
      "safeMarginStart": 0,
      "safeMarginEnd": 0,
      "priority": 0
    },
    {
      "id": "bottom_dock",
      "name": "Bottom Center: Dock / Taskbar",
      "edge": "bottom",
      "startFraction": 0.333,
      "endFraction": 0.666,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "shortcut:plasmashell:activate widget 111",
      "oskPolicy": "Disabled",
      "safeMarginStart": 0,
      "safeMarginEnd": 0,
      "priority": 0
    },
    {
      "id": "bottom_systemtray",
      "name": "Bottom Right: System Tray Popup Menu",
      "edge": "bottom",
      "startFraction": 0.666,
      "endFraction": 1.0,
      "gestureType": "inward_swipe",
      "activationThreshold": 45,
      "enabled": true,
      "action": "shortcut:plasmashell:activate widget 145",
      "oskPolicy": "Disabled",
      "safeMarginStart": 0,
      "safeMarginEnd": 0,
      "priority": 0
    }
  ]
}
